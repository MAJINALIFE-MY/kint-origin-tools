# このドメインの cybozu.com ログイン情報
# originのみ（パス・クエリ・フラグメントなし）
CYBOZU_BASE_URL=https://xxx.cybozu.com
CYBOZU_USERNAME=your-login-name
# パスワードは平文でもよい。暗号化するときは、このフォルダで kint-origin secret を実行する。
CYBOZU_PASSWORD=your-password
CYBOZU_LANGUAGE=ja

# 任意: API 実行ごとの最小間隔（ミリ秒）。負荷対策用。未設定または 0 は間隔なし。
# ※ cli-kintone 経由の処理（pull records の CSV 本体）には適用されません。
# CYBOZU_API_INTERVAL_MS=0

# 任意: kintone documentation MCP の設定が見つからないときの警告。
# Claude のコネクタや ChatGPT のアプリで設定済みなど、kint-origin から設定が見えない場合は false にすると警告を出しません。
# KINT_ORIGIN_DOCS_MCP_WARNING=false

# Optional absolute path to a private addon source directory (not stored in this domain repository).
# KINT_ORIGIN_ADDON_DIR=/path/to/kint-origin-addon

# --- 操作制限（ハーネス） ---
# kint-origin がこのドメインで実行してよい操作を true / false で指定します。
# 下の値は既定値です（アプリ設定・スペースの取得だけ許可。レコード・ユーザー・push は禁止）。許可したい操作だけ true にしてください。
# 行を削除する・値を空にした場合も既定値になります。
# このファイルの値だけが有効で、環境変数では上書きできません。実効値は `kint-origin policy` で確認できます。
# AI エージェントはこのファイルを変更しません。許可の変更はユーザーが行ってください。
# 注意: 値の後ろにコメントを書かないでください（不正値として全コマンドが停止します）。
#
# pull index / kintone / app / spaces / guestspaces / tracked-spaces / favorite（既定 true）
KINT_ORIGIN_ALLOW_PULL_KINTONE=true
# pull records / pull comments（レコード・コメント。顧客データを含む。既定 false）
KINT_ORIGIN_ALLOW_PULL_RECORDS=false
# --all-indexed とお気に入りの複数アプリデータ取得（PULL_RECORDS と併用。既定 false）
KINT_ORIGIN_ALLOW_BULK_RECORDS=false
# 全アプリのレコードを実行1回だけ取得する許可（実行確認後、自動で false に戻る。既定 false）
KINT_ORIGIN_ALLOW_PULL_RECORDS_ALL_ONCE=false
# 全アプリのコメントを実行1回だけ取得する許可（実行確認後、自動で false に戻る。既定 false）
KINT_ORIGIN_ALLOW_PULL_COMMENTS_ALL_ONCE=false
# pull users と pull all（共通管理ユーザー。個人情報を含む。既定 false）
KINT_ORIGIN_ALLOW_PULL_USERS=false
# push app（アプリ設定・customize・新規アプリ作成を許可。既定 false。diff は許可不要）
KINT_ORIGIN_ALLOW_PUSH_APP=false
# push space（スペースの設定・本文の即時反映。既定 false。差分確認の kint-origin diff space は許可不要）
KINT_ORIGIN_ALLOW_PUSH_SPACE=false
# push records / import（レコードの更新・追加・添付コピー・CSV取込。顧客データを書き換える。既定 false。show / diff は PULL_RECORDS で動く）
KINT_ORIGIN_ALLOW_PUSH_RECORDS=false
